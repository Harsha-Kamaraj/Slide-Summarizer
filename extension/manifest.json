{
  "manifest_version": 3,
  "name": "Slide Summarizer",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Turn PESU Academy lecture slides into a detailed PDF summary.",
  "permissions": [
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.pesuacademy.com/*",
    "https://pesuacademy.com/*",
    "https://files.pesuacademy.com/*",
    "http://localhost:8000/*",
    "https://slide-summarizer.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pesuacademy.com/Academy/*",
        "https://pesuacademy.com/Academy/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
