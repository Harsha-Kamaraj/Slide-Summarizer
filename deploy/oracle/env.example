# Copy to .env (setup.sh does this) and fill in the secrets. Never commit .env.

# Public address, e.g. 129-154-1-2.sslip.io (sslip.io maps it to the IP)
DOMAIN=

# Main LLM: Groq, models chosen by evaluation (docs/DECISIONS.md #27-28)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
NOTES_MODEL=openai/gpt-oss-120b
TEXT_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b
LLM_REASONING_EFFORT=low
LLM_MAX_RETRIES=6

# Fallback when the main model's daily quota runs out (decision #30)
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=openai/gpt-oss-20b
FALLBACK_VISION_MODEL=qwen/qwen3.8-27b
FALLBACK_REASONING_EFFORT=low

# Serving
DAILY_LIMIT=10
JOB_WORKERS=2
